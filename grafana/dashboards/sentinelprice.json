      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_SENTINELPRICE_DB}"
          },
          "rawSql": "SELECT\n  source,\n  sku,\n  product_name,\n  brand,\n  price_current,\n  price_original,\n  discount_pct,\n  currency,\n  availability,\n  rating,\n  review_count,\n  scraped_at\nFROM latest_prices\nWHERE\n  ($source = 'all' OR source = '$source')\n  AND ($sku = 'all' OR sku = '$sku')\nORDER BY scraped_at DESC\nLIMIT 200",
          "format": "table",
          "refId": "A"
        }
