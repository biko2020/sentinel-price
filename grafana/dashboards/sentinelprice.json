      "targets": [
        {
          "rawSql": "SELECT\n  product_name, source, sku, currency,\n  prev_price, price_current, change_pct, scraped_at\nFROM price_changes\nWHERE change_pct < 0\n  AND $__timeFilter(scraped_at)\nORDER BY change_pct ASC\nLIMIT 50",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
