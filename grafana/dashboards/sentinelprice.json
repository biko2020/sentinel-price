            "type": "postgres",
            "uid": "${DS_SENTINELPRICE_DB}"
          },
          "rawSql": "SELECT\n  scraped_at AS time,\n  source AS metric,\n  change_pct AS value\nFROM price_changes\nWHERE\n  scraped_at BETWEEN $__timeFrom() AND $__timeTo()\n  AND ($source = 'all' OR source = '$source')\nORDER BY time",
          "format": "time_series",
          "refId": "A"
