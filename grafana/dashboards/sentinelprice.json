            "uid": "${DS_SENTINELPRICE_DB}"
          },
          "rawSql": "SELECT\n  s.name AS \"Retailer\",\n  COUNT(*) AS \"Snapshots\"\nFROM pricing_history ph\nJOIN products p ON p.product_id = ph.product_id\nJOIN sources s ON s.source_id = p.source_id\nWHERE ph.scraped_at BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY s.name\nORDER BY \"Snapshots\" DESC",
          "format": "table",
          "refId": "A"
        }
      ]
