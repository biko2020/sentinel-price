            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value FROM pricing_history",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Price Changes (24h)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS value FROM price_changes WHERE scraped_at >= NOW() - INTERVAL '24 hours'",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last Crawl",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "unit": "dateTimeFromNow",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT EXTRACT(EPOCH FROM MAX(scraped_at)) * 1000 AS value FROM pricing_history",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Biggest Drop (7d)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT ABS(MIN(change_pct)) AS value FROM price_changes WHERE scraped_at >= NOW() - INTERVAL '7 days' AND change_pct < 0",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Active Retailers",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT source) AS value FROM latest_prices",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Price History by Retailer",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "legend": {
          "calcs": [
            "min",
            "max",
            "last"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "auto"
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT\n  $__timeGroup(ph.scraped_at,'$__interval') AS time,\n  s.name AS metric,\n  ROUND(AVG(ph.price_current)::numeric, 2) AS value\nFROM pricing_history ph\nJOIN products p ON p.product_id = ph.product_id\nJOIN sources  s ON s.source_id  = p.source_id\nWHERE $__timeFilter(ph.scraped_at)\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Product Coverage by Retailer",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "displayLabels": [
          "percent",
          "name"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "pie"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT source AS metric, COUNT(DISTINCT sku) AS value\nFROM latest_prices\nGROUP BY source\nORDER BY value DESC",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Price Changes Over Time (%)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "legend": {
          "calcs": [
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "points",
            "pointSize": 6,
            "showPoints": "always",
            "lineWidth": 1
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT\n  scraped_at AS time,\n  source AS metric,\n  change_pct AS value\nFROM price_changes\nWHERE $__timeFilter(scraped_at)\nORDER BY time",
          "format": "time_series",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Snapshots Collected per Retailer",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "rawSql": "SELECT\n  s.name AS \"Retailer\",\n  COUNT(*) AS \"Snapshots\"\nFROM pricing_history ph\nJOIN products p ON p.product_id = ph.product_id\nJOIN sources  s ON s.source_id  = p.source_id\nWHERE $__timeFilter(ph.scraped_at)\nGROUP BY s.name\nORDER BY \"Snapshots\" DESC",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Latest Prices \u2014 All Products",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "postgres",
        "uid": "sentinelprice_postgres"
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "enablePagination": true,
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "price_current"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 100
                    },
                    {
                      "color": "orange",
                      "value": 500
                    },
                    {
                      "color": "red",
                      "value": 1000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "availability"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "in_stock": {
                        "color": "green",
                        "index": 0,
                        "text": "\u2713 In Stock"
                      },
                      "out_of_stock": {
                        "color": "red",
                        "index": 1,
                        "text": "\u2717 Out of Stock"
                      },
                      "preorder": {
                        "color": "blue",
                        "index": 2,
                        "text": "\u23f3 Pre-order"
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "discount_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "rawSql": "SELECT\n  source, sku, product_name, brand,\n  price_current, price_original, discount_pct,\n  currency, availability, rating, review_count, scraped_at\nFROM latest_prices\nORDER BY scraped_at DESC\nLIMIT 200",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sentinelprice_postgres"
          }
        }
      ]
    },
