    {
      "id": 7,
      "type": "timeseries",
      "title": "Price History \u2014 $__interval resolution",
      "description": "Average price per retailer over time. Use the SKU variable to filter to a specific product.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "${DS_SENTINELPRICE_DB}"
      },
      "options": {
        "legend": {
          "calcs": [
            "min",
            "max",
            "last"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Price (USD)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_SENTINELPRICE_DB}"
          },
          "rawSql": "SELECT\n  time_bucket('$__interval', ph.scraped_at) AS time,\n  s.name AS metric,\n  AVG(ph.price_current) AS value\nFROM pricing_history ph\nJOIN products p ON p.product_id = ph.product_id\nJOIN sources s ON s.source_id = p.source_id\nWHERE\n  ph.scraped_at BETWEEN $__timeFrom() AND $__timeTo()\n  AND ($sku = 'all' OR p.sku = '$sku')\n  AND ($source = 'all' OR s.name = '$source')\nGROUP BY 1, 2\nORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
