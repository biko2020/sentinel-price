# =============================================================================
#  SentinelPrice · Environment Configuration Template
# =============================================================================


# -----------------------------------------------------------------------------
# POSTGRESQL DATABASE
# -----------------------------------------------------------------------------

POSTGRES_DB=sentinelprice
POSTGRES_USER=<your_db_user>
POSTGRES_PASSWORD=<your_db_password>
POSTGRES_HOST=db
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# PROXY CONFIGURATION
# -----------------------------------------------------------------------------

PROXY_ENABLED=true
PROXY_ENDPOINT=<http://proxy.yourprovider.com:PORT>
PROXY_USERNAME=<your_proxy_username>
PROXY_PASSWORD=<your_proxy_password>
PROXY_API_KEY=<your_proxy_api_key>


# -----------------------------------------------------------------------------
# SCRAPY CONCURRENCY & RATE LIMITING
# -----------------------------------------------------------------------------

CONCURRENT_REQUESTS=16
CONCURRENT_REQUESTS_PER_DOMAIN=4
DOWNLOAD_DELAY=1.5
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_TARGET_CONCURRENCY=2.0


# -----------------------------------------------------------------------------
# SCRAPY COMPLIANCE SETTINGS
# -----------------------------------------------------------------------------


ROBOTSTXT_OBEY=true
COOKIES_ENABLED=true


# -----------------------------------------------------------------------------
#  PLAYWRIGHT · JS RENDERING
# -----------------------------------------------------------------------------

PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_BROWSER_TYPE=chromium
PLAYWRIGHT_AUTO_UPGRADE_ON_BLOCK=true


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FILE=

# -----------------------------------------------------------------------------
# ALERTING 
# -----------------------------------------------------------------------------

ALERT_SLACK_ENABLED=true
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_PRICE_DROP_THRESHOLD=5
ALERT_PRICE_INCREASE_THRESHOLD=10

ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_RECIPIENT=you@example.com
ALERT_EMAIL_SENDER=you@gmail.com
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=you@gmail.com
ALERT_EMAIL_SMTP_PASSWORD=your_app_password
ALERT_PRICE_DROP_THRESHOLD=5
ALERT_PRICE_INCREASE_THRESHOLD=10